# Copy this file to .env and fill in values before running locally.

# PostgreSQL connection string
DATABASE_URL=postgresql://lis:lis@localhost:5433/lis_logs

# Bearer token that all ingest clients must send in the Authorization header.
# REQUIRED in staging/prod (ENV != dev). Leave empty only in local dev.
INGEST_TOKEN=

# Deployment environment: dev | staging | prod
# If ENV != dev and INGEST_TOKEN is empty, the service will refuse to start.
ENV=dev

# --- DB pool tuning ---
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_COMMAND_TIMEOUT=10   # seconds
DB_ACQUIRE_TIMEOUT=5    # seconds

# --- Batcher tuning ---
BATCH_MAX=500           # flush when buffer reaches this many events
BATCH_FLUSH_SEC=2       # also flush every N seconds even if buffer isn't full
QUEUE_MAX=20000         # max events held in-memory before backpressure (503)
